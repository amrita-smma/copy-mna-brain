{
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "ignoreCommand": "bash scripts/skip-deploy.sh",
  "functions": {
    "src/app/api/queues/send-email/route.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "send-email"
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/resurface-deals",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily-pulse",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/crm-suggested-questions",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/close-votes",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/task-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/cleanup-jobs",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/compact-checkpoints",
      "schedule": "30 * * * *"
    }
  ]
}
