NEXT_PUBLIC_POSTHOG_KEY=posthog_key
NEXT_PUBLIC_POSTHOG_HOST=posthog_host
ANTHROPIC_API_KEY=your_anthropic_api_key
INVEN_API_KEY=your_inven_api_key
# Valyu.ai search (Funds & Investing + Combined Copilot agents)
VALYU_API_KEY=your_valyu_api_key

# S3 Configuration (AWS S3)
AWS_REGION=ap-southeast-3
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=mna-files

# AWS SES Configuration (transactional email — forgot-password reset link, etc.)
# - SES_REGION defaults to AWS_REGION. Set explicitly if your verified domain
#   identity lives in a different region than S3 (SES is regional).
# - SES_FROM_EMAIL must be a verified sender identity in SES; the placeholder
#   will fail at send time, which is intentional (loud failure > silent drop).
# - SES_REPLY_TO is optional.
# - NEXT_PUBLIC_APP_URL is the base URL used to build the reset link inside
#   the email body (e.g. https://brain.example.com).
# SES_REGION=ap-southeast-3
# SES_FROM_EMAIL=Brain 2.0 <noreply@example.com>
# SES_REPLY_TO=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local dev with MinIO (uncomment, set creds above to minioadmin/minioadmin).
# AWS_S3_ENDPOINT is what the server uses; AWS_S3_PUBLIC_ENDPOINT is what goes
# into presigned URLs (must be reachable from the browser).
# Host dev: both = http://127.0.0.1:9000
# Docker dev: endpoint=http://minio:9000, public_endpoint=http://localhost:9000
# AWS_S3_ENDPOINT=http://127.0.0.1:9000
# AWS_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# AWS_S3_FORCE_PATH_STYLE=true

# Database (DB_* only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mna
DB_USER=postgres
DB_PASSWORD=secret
# Set true for IAM auth (app/Vercel). Leave DB_PASSWORD empty in this mode.
# RDS_IAM_DB_AUTH=true
# DB_USER=mna_iam
# DB_PASSWORD=

# Auth.js (NextAuth v5) — generate with: npx auth secret
AUTH_SECRET=your_auth_secret

# Google SSO — OAuth client id used as the audience when validating the Google
# ID token (from the "Sign in with Google" button on /login). Sign-in works
# without it (signature/issuer/expiry are still checked), but setting it
# enforces that the token was minted for this app.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Same Google OAuth client id, exposed to the browser so Google Identity
# Services can render the "Sign in with Google" button on the login page.
# OAuth client ids are not secret. Without it the button is hidden and only
# email/password sign-in is available.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Shared secret sent as X-Api-Secret on public auth endpoints (signup,
# forget-password, reset-password). NEXT_PUBLIC_ because the browser needs to
# attach it — bot deterrent only, not real authentication.
ADMIN_SECRET=your_salt_secret

# Iframe embedding (Brain Launcher) — see README "Iframe embedding".
# When true: the CSP `frame-ancestors` header permits the launcher origins and
# NextAuth cookies become `SameSite=None; Secure; Partitioned` (required to
# survive a cross-site iframe). Leave false/unset for the standalone deployment
# (keeps `frame-ancestors 'self'` + `SameSite=Lax`).
IFRAME_EMBED_ENABLED=false

# Origins allowed to frame this app and exchange postMessages with it
# (whitespace- or comma-separated). NEXT_PUBLIC_ so the same list is used by
# the server CSP header and the client-side postMessage origin allowlist.
# Defaults to the launcher origins below when unset.
NEXT_PUBLIC_IFRAME_ALLOWED_ANCESTORS="https://brain.starcapital.co.id https://brain-stg.starcapital.co.id http://localhost:3000"

# Launcher SSO — the Brain Launcher that embeds this app signs the user's
# identity as an RS256 JWT and passes it as `?token=` on the URL. Set this to
# the launcher's origin so we can fetch its JWKS and verify the token.
# Production:  https://brain.starcapital.co.id
# Staging:     https://brain-stg.starcapital.co.id
# Local dev:   http://localhost:3000
LAUNCHER_ORIGIN=https://brain.starcapital.co.id
# LAUNCHER_ORIGIN=https://brain-stg.starcapital.co.id  # staging
# LAUNCHER_ORIGIN=http://localhost:3000                 # local dev against local launcher

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bebas
LOG_LEVEL=DEBUG

GOOGLE_VAULT_SERVICE_ACCOUNT=insert-base64-service-account-here
GOOGLE_VAULT_IMPERSONATE=crm.vault@starcapital.co.id
CRM_GOOGLE_VAULT_SYNC=false

# E2E test credentials (Playwright). TEST_ENV selects which set is used.
# Preview CI writes `.env.e2e.local` via `.github/workflows/e2e-preview.yml`.
TEST_ENV=local
E2E_DATA_MODE=real
LOCAL_TEST_EMAIL=local_user@example.com
LOCAL_TEST_PASSWORD=local_password
STAGING_TEST_EMAIL=staging_user@example.com
STAGING_TEST_PASSWORD=staging_password
PRODUCTION_TEST_EMAIL=production_user@example.com
PRODUCTION_TEST_PASSWORD=production_password
# Preview DBs are seeded by preview-db.yml — defaults match scripts/seed.ts.
PREVIEW_TEST_EMAIL=test@sqe.co.id
PREVIEW_TEST_PASSWORD=password

# E2E target URLs per TEST_ENV. `local` builds & serves a local server; staging,
# production, and preview target already-deployed sites (no local build).
LOCAL_BASE_URL=http://localhost:3000
STAGING_BASE_URL=https://mna-stg.sqe.co.id
PRODUCTION_BASE_URL=https://mna.sqe.co.id
PREVIEW_BASE_URL=

FLAGS=
FLAGS_SECRET=

# Neo4j (graph database — company relationship graph)
# Docker: bolt://localhost:7687, browser console at http://localhost:7474
#
# Preferred: a single connection string with URL-encoded credentials. Encode
# special characters in the password (e.g. ) = ! } # become %29 %3D %21 %7D %23)
# so they survive shell/deployment-platform escaping:
#   NEO4J_URL=bolt://neo4j:p%40ss%21word@host:7687
NEO4J_URL=bolt://neo4j:password@localhost:7687
#
# Legacy fallback (used by local Docker dev; credentials match NEO4J_AUTH in
# docker-compose.yml). Only used when NEO4J_URL is unset.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# Feature flags (env-based fallbacks when FLAGS adapter is not set)
COMPANY_GRAPH_ENABLED=true
INSIGHTS_DASHBOARD_ENABLED=false
CHAT_CACHE_ENABLED=false

# Langfuse Local Setup (matches dummy init in docker-compose.yml)
# LANGFUSE_SECRET_KEY=sk-lf-1234567890
# LANGFUSE_PUBLIC_KEY=pk-lf-1234567890
# LANGFUSE_BASE_URL=http://langfuse-web:3000
